generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// ENUMS
// ============================================

enum OfferType {
  RCVM_88
  RCVM_175
}

enum OfferStatus {
  EM_TRIAGEM
  EM_CAPTACAO
  COMPLETA
  ADIMPLENTE
  INADIMPLENTE
}

enum EntityStatus {
  ATIVO
  INATIVO
  EM_ANALISE
  SUSPENSO
  BLOQUEADO
  OUTRO
}

enum PersonType {
  FISICA
  JURIDICA
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ORIGINADOR
  DISTRIBUIDOR
  ASSESSOR
  INVESTIDOR
}

// ============================================
// MODELS
// ============================================

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  role       UserRole @default(INVESTIDOR)
  name       String?
  avatar     String?
  blocked    Boolean  @default(false)
  // Cadastro V2: persona (buy/sell/ambos), aceites (termos/NDA/minuta) e dados da empresa
  signupData Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  originatorProfile Originator?
  investorProfile   InvestorProfile?

  @@map("users")
}

// ⚠️ NÃO REMOVER. A fase buy-side foi congelada em 15/08/2026 (código parqueado em
// feature/buy-side-wip), mas este modelo e o campo User.signupData continuam aqui de
// propósito: a tabela investor_profiles e a coluna users.signupData JÁ EXISTEM no banco
// desde 13/07/2026. Como o Supabase é compartilhado entre dev e produção, remover isto
// daqui faria o próximo `prisma db push` derrubar tabela e coluna EM PRODUÇÃO.
model InvestorProfile {
  id                 String   @id @default(cuid())
  // Preferências de alocação (planilha Buy Side Onboarding — propriedades de Contato no HubSpot)
  sectors            String[] @default([]) // area_of_interest (labels)
  instruments        String[] @default([]) // instrumentos_financeiro (labels)
  segments           String[] @default([]) // legado (mantido para compat)
  segmentsBySector   Json?    // { realEstate: [], agribusiness: [], infrastructure: [], judicialAssets: [] } — valores internos HubSpot
  sectorOther        String?  // area_of_interest_others
  segmentOther       String?  // segmento livre quando setor "Outros"
  geoPreferences     String[] @default([]) // UFs (convertidas p/ preferred_location no HubSpot)
  ticketMin          Decimal? @db.Decimal(15, 2) // minimum_ticket
  ticketMax          Decimal? @db.Decimal(15, 2) // maximum_ticket
  minRemuneration    String?  // minimum_return
  requiresStructurer Boolean? // requires_co_structuring (necessita co-estruturar)
  minSalesPercent    Int?     // minimum_sales_percentage (condicional Imobiliário)
  minWorksProgress   Int?     // minimum_construction_progress (condicional Imobiliário)
  dealmatchObs       String?  // dealmatch_observations
  // Personalize seu perfil (contato)
  cellphone          String?
  cpf                String?
  jobTitle           String?  // job_title (valores internos: CEO, PARTNER, ...)
  // Seções flexíveis legadas
  companyProfile     Json?
  objectives         Json?
  onboardingDone     Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("investor_profiles")
}

model Originator {
  id               String       @id @default(cuid())
  name             String
  cnpj             String       @unique
  type             PersonType
  email            String       @unique
  phone            String
  totalEmitted     Decimal      @default(0) @db.Decimal(15, 2)
  activeOffers     Int          @default(0)
  status           EntityStatus @default(ATIVO)
  hubspotContactId String?
  hubspotCompanyId String?
  registrationDate DateTime     @default(now())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  offers Offer[]

  @@index([cnpj])
  @@index([status])
  @@map("originators")
}

model Offer {
  id           String      @id @default(cuid())
  name         String
  type         OfferType
  status       OfferStatus @default(EM_CAPTACAO)
  volume       Decimal     @db.Decimal(15, 2)
  raised       Decimal     @default(0) @db.Decimal(15, 2)
  progress     Int         @default(0) // 0-100
  deadline     DateTime
  minTicket    Decimal     @db.Decimal(15, 2)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  metadata     Json?

  originatorId String
  originator   Originator @relation(fields: [originatorId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([originatorId])
  @@index([deadline])
  @@map("offers")
}
